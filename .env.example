# Copy to .env (never commit it). Read by the indexer (npm start), deploy.sh and simulate.
# NETWORK picks which *_TESTNET / *_MAINNET block is used; every script checks the RPC's chain id.

# --- wallet: deployer, owner (creator fees) and minter ----------------------------------------
MINTER_ADDRESS=0x...
MINTER_KEY=0x...

NETWORK=testnet                 # testnet (46630) or mainnet (4663)

# --- shared rules ------------------------------------------------------------------------------
MAX_SUPPLY=3333
MIN_BUY_USD=10                  # one buy of at least this much earns a Poon
EXCLUDE=                        # wallets that never get a Poon (comma-separated)

# --- testnet (chain 46630) ---------------------------------------------------------------------
RPC_URLS_TESTNET=https://rpc.testnet.chain.robinhood.com   # comma-separated, first = primary
WS_URL_TESTNET=                 # optional: instant buy detection, far fewer idle RPC calls
ETH_USD_TESTNET=100000          # testnet ETH has no price; $10 test buy = 0.0001 ETH
TOKEN_TESTNET=                  # written by ./deploy.sh testnet
CURVE_TESTNET=
POONS_TESTNET=
RENDERER_TESTNET=
START_BLOCK_TESTNET=

# --- mainnet (chain 4663) ----------------------------------------------------------------------
RPC_URLS_MAINNET=https://your-paid-rpc,https://rpc.mainnet.chain.robinhood.com
WS_URL_MAINNET=
TOKEN_MAINNET=                  # the Pons token, after launch
POONS_MAINNET=                  # written by CONFIRM_MAINNET=yes ./deploy.sh mainnet
RENDERER_MAINNET=
START_BLOCK_MAINNET=

# --- tuning (optional) -------------------------------------------------------------------------
# POLL_MS=250  IDLE_POLL_MS=5000  MAX_RANGE=2000  RESCAN_BLOCKS=6000  RESCAN_EVERY_MS=300000
# MAX_BATCH=120  CONFIRMATIONS=0  API_PORT=8788  DRY_RUN=0
