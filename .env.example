# Copy to .env (never commit it). Read by the indexer (npm start) and the deploy scripts.

# --- network ---------------------------------------------------------------
NETWORK=testnet                 # testnet (46630) or mainnet (4663)
# Comma-separated; the indexer fails over between them. Use at least one private endpoint on mainnet.
RPC_URLS=https://rpc.testnet.chain.robinhood.com

# --- wallets ---------------------------------------------------------------
MINTER_ADDRESS=0x...            # hot wallet with MINTER_ROLE (pays drop gas)
MINTER_KEY=0x...

# --- contracts (filled in after deploy) ------------------------------------
TOKEN=0x...                     # the Pons token (testnet: MockPonsToken)
CURVE=                          # testnet only: MockPonsCurve. Mainnet uses the Pons curve automatically.
POONS=0x...
START_BLOCK=                    # block the token launched in

# --- rules -----------------------------------------------------------------
MAX_SUPPLY=3333
MIN_BUY_USD=10                  # one buy of at least this much qualifies
EXCLUDE=                        # wallets that never get a Poon (deployer, treasury, ...)

# --- tuning ----------------------------------------------------------------
POLL_MS=200
MAX_RANGE=2000
RESCAN_BLOCKS=6000
RESCAN_EVERY_MS=60000
MAX_BATCH=120
CONFIRMATIONS=0
API_PORT=8788
DRY_RUN=0                       # 1 = compute everything, send no transactions

# Testnet only: pin ETH/USD (testnet ETH has no price). Leave unset on mainnet.
ETH_USD=

# Optional websocket endpoint of the same provider: instant buy detection, far fewer idle RPC calls
WS_URL=
